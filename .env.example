# ---- Site / navigation -------------------------------------------------
# Landing page the bot starts from
BASE_URL=https://spribe.co/welcome
NAVIGATION_TIMEOUT=60000
# How long the bot runs before shutting itself down (ms). Default: 24h
RUN_DURATION_MS=86400000

# ---- Browser ------------------------------------------------------------
# Set to true to run without a visible browser window
HEADLESS=false

# ---- Game loop ----------------------------------------------------------
# How often the game page is polled (ms)
POLLING_INTERVAL=4000
# Number of previous rounds used for the moving average
HISTORY_SIZE=3
# Reload the page after this many consecutive failed poll cycles
MAX_CONSECUTIVE_FAILURES=5
# Write off a bet that could never be confirmed as in-flight after (ms)
BET_STALENESS_MS=120000
# Jitter guard: ignore bubble changes arriving sooner than this after the
# previous accepted round end (defers them one cycle to confirm)
MIN_ROUND_GAP_MS=2000
# Absolute max lifetime of an open bet before it is written off, so the
# loop can never get stuck if a crash is missed (ms)
MAX_BET_LIFETIME_MS=180000

# ---- Live dashboard -----------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000

# ---- Database (optional) ------------------------------------------------
DATABASE_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aviatorBot

# ---- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
