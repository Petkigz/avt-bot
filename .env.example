# ---- Site / navigation (BetPawa Uganda by default) ----------------------
BASE_URL=https://www.betpawa.ug
GAME_URL=https://www.betpawa.ug/virtual/aviator
NAVIGATION_TIMEOUT=60000
# How long the bot runs before shutting itself down (ms). Default: 24h
RUN_DURATION_MS=86400000

# ---- Login -----------------------------------------------------------------
# true = bot pauses at the login page and waits for ENTER after you log in
MANUAL_LOGIN=true

# ---- Browser ------------------------------------------------------------
HEADLESS=false
# Persistent Chrome profile (keeps your BetPawa login between runs).
# Set to an empty string to disable.
USER_DATA_DIR=

# ---- Game loop ----------------------------------------------------------
POLLING_INTERVAL=4000
HISTORY_SIZE=5
MAX_CONSECUTIVE_FAILURES=5
BET_STALENESS_MS=120000
MIN_ROUND_GAP_MS=2000
MAX_BET_LIFETIME_MS=180000
# Settle a round if the flight ended but the crash bubble never appears
FLIGHT_END_GRACE_MS=10000
# Rounds to sit out after a strategy/progression reset
RESET_COOLDOWN_ROUNDS=2
# Never let a bet drop the balance below this reserve (UGX)
MIN_BALANCE_RESERVE=0

# ---- Adaptive model (history learning) -----------------------------------
MODEL_ENABLED=true
# Rounds the model wants before it starts gating decisions
MODEL_MIN_SAMPLE_SIZE=30
# Only bet when estimated P(crash >= target) is at least this
MODEL_MIN_ENTRY_PROBABILITY=0.60
# Learning can tighten the threshold up to this ceiling
MODEL_MAX_ENTRY_PROBABILITY=0.85
# Pause betting after this many consecutive crashes below target
MODEL_COLD_STREAK_LIMIT=3
# Resume after this many crashes at/above target
MODEL_COLD_RECOVERY_COUNT=1

# ---- Pattern detection (recent round clusters) ---------------------------
PATTERN_ENABLED=true
# Cluster lengths to mine (exact lengths from your spec: 10, 5, 3)
PATTERN_LENGTHS=10,5,3
# Observations a pattern needs before it is trusted
PATTERN_MIN_SUPPORT=8
# Symbol bins L/M/H boundaries
PATTERN_BINS=1.5,2.5
# Confidence multiplier when no known pattern matches
PATTERN_NO_PATTERN_PENALTY=0.95

# ---- Bankroll & confidence tiers (risk control) ---------------------------
# Hard loss limits in UGX (cautious BetPawa defaults)
SESSION_LOSS_LIMIT=3000
DAILY_LOSS_LIMIT=6000
# A stake can never exceed this fraction of the bankroll
MAX_STAKE_FRACTION=0.015
# While unproven (MICRO tier) stakes are capped at this fraction
MICRO_STAKE_FRACTION=0.004
# Warm-up: rounds studied before ANY bet is allowed
MIN_ROUNDS_OBSERVE=150
# Promotion MICRO -> ARMED
PROMOTION_MIN_DECISIONS=25
PROMOTION_HIT_RATE=0.58
# Demotion ARMED -> MICRO
DEMOTION_HIT_RATE=0.48
DECISION_WINDOW=30
# Volatility risk evaluation
HIGH_VOLATILITY_THRESHOLD=2.0
VOLATILITY_CONFIDENCE_PENALTY=0.07

# ---- Mode -------------------------------------------------------------------
# SAFE DEFAULT: paper mode never clicks; it observes and logs hypothetical
# trades. Run `npm run simulate` first, then paper mode, and only set this
# to false when you fully trust the behavior.
PAPER_MODE=true

# Hypothetical bankroll for the paper-mode Profits simulation.
# 0 (default) = assume the selected strategy's capital: 100 x its initial bet.
#PAPER_BANKROLL=0

# Strategy preset override (skips the interactive menu). ALL presets are
# available: MICRO | CONSERVATIVE | MODERATE | AGGRESSIVE
# Leave empty to choose interactively at startup (menu also offers CUSTOM).
STRATEGY=

# Strict safety profile: stay in the MICRO tier forever — micro-sized bets
# only, never promoted to full strategy stakes.
MICRO_ONLY=false

# ---- Multi-site / multi-account ---------------------------------------------
# Which site profile to start on. Built-in: betpawa.ug | betpawa.co.zm |
# betpawa.co.mw | custom  (you can switch sites live from the dashboard)
SITE=betpawa.ug

# Max concurrent browser sessions (one per account). Extra switches close the
# oldest session. Keep this low — each session is a full browser profile.
MAX_SESSIONS=1

# Only used when SITE=custom — point the bot at ANY Spribe-Aviator site.
CUSTOM_BASE_URL=
CUSTOM_GAME_URL=
CUSTOM_LOGIN_URL=
CUSTOM_CURRENCY=UNITS
CUSTOM_MIN_STAKE=0
# Optional CSS selector hints for the custom site (dashboard/tooling only —
# login is always manual, the bot never types credentials):
CUSTOM_LOGIN_OPEN_SELECTOR=
CUSTOM_LOGIN_USER_SELECTOR=
CUSTOM_LOGIN_PASS_SELECTOR=
CUSTOM_LOGIN_SUBMIT_SELECTOR=
CUSTOM_LOGGED_IN_SELECTOR=
CUSTOM_BALANCE_SELECTOR=

# ---- Live dashboard -----------------------------------------------------
DASHBOARD_ENABLED=true
# If the port is busy, the bot automatically moves to the next free one
# (it writes the final port to data/dashboard-port).
DASHBOARD_PORT=4100
# Prediction engine tuning (see README "Prediction engine"):
# MODEL_RECENCY_HALF_LIFE=250   rounds until an old result counts half
# MODEL_RECENT_WINDOW=100       window for recency stats + uncertainty bound
# MODEL_WILSON_CUSHION=0.05     uncertainty tolerance on the entry floor
# CONFIDENCE_SCALING=true       scale stakes 50-100% with model confidence
# Start everything from the dashboard instead of terminal prompts: the bot
# waits until you press LAUNCH in Mission Control (site + account + strategy).
# true = dashboard-first (default, and forced by start-bot.bat)
# false = classic terminal menus (site/account/strategy asked in the console)
UI_START=true
# Interface the dashboard binds to. DEFAULT 127.0.0.1 = your machine only
# (recommended — the dashboard has no built-in auth). 0.0.0.0 would expose
# it to your LAN.
DASHBOARD_HOST=127.0.0.1

# ---- Database (optional) ------------------------------------------------
DATABASE_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aviatorBot

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=info
